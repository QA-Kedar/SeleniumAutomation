            "date": 1763444994190,
            "name": "Commit-0",
            "content": "<!DOCTYPE html>\n<html lang=\"en\">\n<head>\n    <meta charset=\"UTF-8\">\n    <meta name=\"viewport\" content=\"width=device-width, initial-scale=1.0\">\n    <title>Selenium Test Dashboard</title>\n    <script src=\"https://cdn.socket.io/4.5.4/socket.io.min.js\"></script>\n    <style>\n        * {\n            margin: 0;\n            padding: 0;\n            box-sizing: border-box;\n        }\n\n        body {\n            font-family: 'Courier New', monospace;\n            background: #0a0e27;\n            color: #00ff41;\n            overflow-x: hidden;\n        }\n\n        .header {\n            background: linear-gradient(135deg, #1a1a2e 0%, #16213e 100%);\n            border-bottom: 2px solid #00ff41;\n            padding: 20px;\n            display: flex;\n            justify-content: space-between;\n            align-items: center;\n            box-shadow: 0 4px 20px rgba(0, 255, 65, 0.2);\n        }\n\n        .header h1 {\n            font-size: 24px;\n            text-shadow: 0 0 10px #00ff41;\n        }\n\n        .header-right {\n            display: flex;\n            gap: 15px;\n            align-items: center;\n        }\n\n        .status-badge {\n            padding: 8px 15px;\n            border-radius: 5px;\n            font-size: 12px;\n            font-weight: bold;\n            text-transform: uppercase;\n            border: 1px solid;\n            animation: pulse 2s ease-in-out infinite;\n        }\n\n        .status-idle {\n            background: rgba(128, 128, 128, 0.2);\n            border-color: #808080;\n            color: #808080;\n        }\n\n        .status-running {\n            background: rgba(255, 165, 0, 0.2);\n            border-color: #ffa500;\n            color: #ffa500;\n        }\n\n        .status-completed {\n            background: rgba(0, 255, 65, 0.2);\n            border-color: #00ff41;\n            color: #00ff41;\n        }\n\n        .status-failed {\n            background: rgba(255, 0, 0, 0.2);\n            border-color: #ff0000;\n            color: #ff0000;\n        }\n\n        @keyframes pulse {\n            0%, 100% { opacity: 1; }\n            50% { opacity: 0.6; }\n        }\n\n        .logout-btn {\n            padding: 8px 15px;\n            background: rgba(255, 0, 0, 0.2);\n            border: 1px solid #ff0000;\n            border-radius: 5px;\n            color: #ff0000;\n            cursor: pointer;\n            text-decoration: none;\n            font-size: 12px;\n            transition: all 0.3s;\n        }\n\n        .logout-btn:hover {\n            background: rgba(255, 0, 0, 0.4);\n            box-shadow: 0 0 15px rgba(255, 0, 0, 0.3);\n        }\n\n        .container {\n            max-width: 1400px;\n            margin: 0 auto;\n            padding: 20px;\n        }\n\n        .control-panel {\n            background: rgba(26, 26, 46, 0.8);\n            border: 2px solid #00ff41;\n            border-radius: 10px;\n            padding: 25px;\n            margin-bottom: 20px;\n            box-shadow: 0 0 30px rgba(0, 255, 65, 0.2);\n        }\n\n        .control-panel h2 {\n            margin-bottom: 20px;\n            font-size: 18px;\n            text-transform: uppercase;\n            letter-spacing: 2px;\n        }\n\n        .button-group {\n            display: flex;\n            gap: 15px;\n            margin-bottom: 20px;\n        }\n\n        .btn {\n            padding: 12px 30px;\n            border: 2px solid;\n            border-radius: 5px;\n            font-family: 'Courier New', monospace;\n            font-size: 14px;\n            font-weight: bold;\n            text-transform: uppercase;\n            cursor: pointer;\n            transition: all 0.3s;\n            letter-spacing: 1px;\n        }\n\n        .btn-start {\n            background: linear-gradient(135deg, #00ff41 0%, #00cc33 100%);\n            border-color: #00ff41;\n            color: #000;\n        }\n\n        .btn-start:hover:not(:disabled) {\n            box-shadow: 0 0 20px rgba(0, 255, 65, 0.5);\n            transform: translateY(-2px);\n        }\n\n        .btn-stop {\n            background: linear-gradient(135deg, #ff4136 0%, #cc0000 100%);\n            border-color: #ff0000;\n            color: #fff;\n        }\n\n        .btn-stop:hover:not(:disabled) {\n            box-shadow: 0 0 20px rgba(255, 0, 0, 0.5);\n            transform: translateY(-2px);\n        }\n\n        .btn-clear {\n            background: rgba(128, 128, 128, 0.2);\n            border-color: #808080;\n            color: #808080;\n        }\n\n        .btn-clear:hover:not(:disabled) {\n            background: rgba(128, 128, 128, 0.4);\n        }\n\n        .btn:disabled {\n            opacity: 0.5;\n            cursor: not-allowed;\n        }\n\n        .stats {\n            display: grid;\n            grid-template-columns: repeat(auto-fit, minmax(200px, 1fr));\n            gap: 15px;\n            margin-top: 20px;\n        }\n\n        .stat-card {\n            background: rgba(0, 0, 0, 0.5);\n            border: 1px solid #00ff41;\n            border-radius: 5px;\n            padding: 15px;\n            text-align: center;\n        }\n\n        .stat-value {\n            font-size: 32px;\n            font-weight: bold;\n            color: #00ff41;\n            text-shadow: 0 0 10px #00ff41;\n        }\n\n        .stat-label {\n            font-size: 12px;\n            color: #0f0;\n            margin-top: 5px;\n            text-transform: uppercase;\n        }\n\n        .log-panel {\n            background: rgba(0, 0, 0, 0.8);\n            border: 2px solid #00ff41;\n            border-radius: 10px;\n            padding: 20px;\n            height: 500px;\n            overflow-y: auto;\n            box-shadow: 0 0 30px rgba(0, 255, 65, 0.2);\n        }\n\n        .log-panel h2 {\n            margin-bottom: 15px;\n            font-size: 18px;\n            text-transform: uppercase;\n            letter-spacing: 2px;\n            position: sticky;\n            top: 0;\n            background: rgba(0, 0, 0, 0.9);\n            padding: 10px 0;\n            z-index: 10;\n        }\n\n        .log-entry {\n            padding: 8px;\n            margin-bottom: 5px;\n            border-left: 3px solid;\n            background: rgba(0, 0, 0, 0.3);\n            font-size: 13px;\n            line-height: 1.5;\n            animation: slideIn 0.3s ease-out;\n        }\n\n        @keyframes slideIn {\n            from {\n                opacity: 0;\n                transform: translateX(-10px);\n            }\n            to {\n                opacity: 1;\n                transform: translateX(0);\n            }\n        }\n\n        .log-info {\n            border-color: #00ff41;\n            color: #00ff41;\n        }\n\n        .log-success {\n            border-color: #0f0;\n            color: #0f0;\n        }\n\n        .log-warning {\n            border-color: #ffa500;\n            color: #ffa500;\n        }\n\n        .log-error {\n            border-color: #ff0000;\n            color: #ff0000;\n        }\n\n        .timestamp {\n            color: #666;\n            font-size: 11px;\n            margin-right: 10px;\n        }\n\n        .log-panel::-webkit-scrollbar {\n            width: 10px;\n        }\n\n        .log-panel::-webkit-scrollbar-track {\n            background: rgba(0, 0, 0, 0.5);\n            border-radius: 5px;\n        }\n\n        .log-panel::-webkit-scrollbar-thumb {\n            background: #00ff41;\n            border-radius: 5px;\n        }\n\n        .log-panel::-webkit-scrollbar-thumb:hover {\n            background: #0f0;\n        }\n\n        .blink {\n            animation: blink 1s step-start infinite;\n        }\n\n        @keyframes blink {\n            50% { opacity: 0; }\n        }\n    </style>\n</head>\n<body>\n    <div class=\"header\">\n        <h1>◄ SELENIUM TEST CONTROL PANEL ►</h1>\n        <div class=\"header-right\">\n            <div id=\"statusBadge\" class=\"status-badge status-idle\">● IDLE</div>\n            <a href=\"{{ url_for('logout') }}\" class=\"logout-btn\">LOGOUT</a>\n        </div>\n    </div>\n\n    <div class=\"container\">\n        <div class=\"control-panel\">\n            <h2>► Control Center</h2>\n            \n            <div class=\"button-group\">\n                <button id=\"startBtn\" class=\"btn btn-start\">\n                    ▶ START TESTS\n                </button>\n                <button id=\"stopBtn\" class=\"btn btn-stop\" disabled>\n                    ■ STOP TESTS\n                </button>\n                <button id=\"clearBtn\" class=\"btn btn-clear\">\n                    ✕ CLEAR LOGS\n                </button>\n            </div>\n\n            <div class=\"stats\">\n                <div class=\"stat-card\">\n                    <div class=\"stat-value\" id=\"totalUrls\">52</div>\n                    <div class=\"stat-label\">Total URLs</div>\n                </div>\n                <div class=\"stat-card\">\n                    <div class=\"stat-value\" id=\"testedUrls\">0</div>\n                    <div class=\"stat-label\">Tested</div>\n                </div>\n                <div class=\"stat-card\">\n                    <div class=\"stat-value\" id=\"passedUrls\">0</div>\n                    <div class=\"stat-label\">Passed</div>\n                </div>\n                <div class=\"stat-card\">\n                    <div class=\"stat-value\" id=\"failedUrls\">0</div>\n                    <div class=\"stat-label\">Failed</div>\n                </div>\n            </div>\n        </div>\n\n        <div class=\"log-panel\" id=\"logPanel\">\n            <h2>► Test Logs <span class=\"blink\">_</span></h2>\n            <div id=\"logContent\"></div>\n        </div>\n    </div>\n\n    <script>\n        const socket = io();\n        const startBtn = document.getElementById('startBtn');\n        const stopBtn = document.getElementById('stopBtn');\n        const clearBtn = document.getElementById('clearBtn');\n        const statusBadge = document.getElementById('statusBadge');\n        const logContent = document.getElementById('logContent');\n        const logPanel = document.getElementById('logPanel');\n        \n        let testedCount = 0;\n        let passedCount = 0;\n        let failedCount = 0;\n\n        socket.on('connect', () => {\n            addLog('Connected to server', 'success');\n        });\n\n        socket.on('log', (data) => {\n            addLog(data.message, data.type, data.timestamp);\n            \n            // Update counters based on log message\n            if (data.message.includes('✓') || data.message.includes('SUCCESS')) {\n                passedCount++;\n                document.getElementById('passedUrls').textContent = passedCount;\n            }\n            if (data.message.includes('PASSED') || data.message.includes('FAILED')) {\n                testedCount++;\n                document.getElementById('testedUrls').textContent = testedCount;\n            }\n            if (data.message.includes('FAILED') || data.message.includes('ERROR')) {\n                failedCount++;\n                document.getElementById('failedUrls').textContent = failedCount;\n            }\n        });\n\n        socket.on('test_status', (data) => {\n            updateStatus(data.status);\n        });\n\n        startBtn.addEventListener('click', () => {\n            socket.emit('start_tests');\n            startBtn.disabled = true;\n            stopBtn.disabled = false;\n            testedCount = 0;\n            passedCount = 0;\n            failedCount = 0;\n            document.getElementById('testedUrls').textContent = '0';\n            document.getElementById('passedUrls').textContent = '0';\n            document.getElementById('failedUrls').textContent = '0';\n        });\n\n        stopBtn.addEventListener('click', () => {\n            socket.emit('stop_tests');\n            startBtn.disabled = false;\n            stopBtn.disabled = true;\n        });\n\n        clearBtn.addEventListener('click', () => {\n            logContent.innerHTML = '';\n            addLog('Logs cleared', 'info');\n        });\n\n        function addLog(message, type = 'info', timestamp = null) {\n            const logEntry = document.createElement('div');\n            logEntry.className = `log-entry log-${type}`;\n            \n            const time = timestamp || new Date().toLocaleTimeString();\n            logEntry.innerHTML = `<span class=\"timestamp\">[${time}]</span>${message}`;\n            \n            logContent.appendChild(logEntry);\n            logPanel.scrollTop = logPanel.scrollHeight;\n        }\n\n        function updateStatus(status) {\n            statusBadge.className = 'status-badge';\n            \n            switch(status) {\n                case 'running':\n                    statusBadge.classList.add('status-running');\n                    statusBadge.textContent = '● RUNNING';\n                    break;\n                case 'completed':\n                    statusBadge.classList.add('status-completed');\n                    statusBadge.textContent = '✓ COMPLETED';\n                    startBtn.disabled = false;\n                    stopBtn.disabled = true;\n                    break;\n                case 'failed':\n                    statusBadge.classList.add('status-failed');\n                    statusBadge.textContent = '✕ FAILED';\n                    startBtn.disabled = false;\n                    stopBtn.disabled = true;\n                    break;\n                case 'stopped':\n                    statusBadge.classList.add('status-idle');\n                    statusBadge.textContent = '■ STOPPED';\n                    startBtn.disabled = false;\n                    stopBtn.disabled = true;\n                    break;\n                default:\n                    statusBadge.classList.add('status-idle');\n                    statusBadge.textContent = '● IDLE';\n            }\n        }\n    </script>\n</body>\n</html>"
        }
    ]
}